{
  "uid": "microrred-vivo",
  "title": "Microrred — Operativo en vivo (simulador)",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "microrred",
    "vivo"
  ],
  "templating": {
    "list": [
      {
        "name": "inversor",
        "label": "Inversor",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "postgres-microrred"
        },
        "query": "SELECT inversor_id FROM gold.dim_inversor WHERE es_actual ORDER BY 1",
        "definition": "SELECT inversor_id FROM gold.dim_inversor WHERE es_actual ORDER BY 1",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "1",
          "value": "1"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Estado de carga de baterías (SOC %)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-microrred"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-microrred"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (inversor_id) ts AS time, 'Inversor ' || inversor_id AS metric, soc_prom_pct AS value FROM operativo.lectura_stream ORDER BY inversor_id, ts DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "green",
                "value": 40
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdMarkers": true
      }
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "Disponibilidad de telemetría (% datos válidos, 10 min)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-microrred"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-microrred"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT now() AS time, 'Inversor ' || inversor_id AS metric, ROUND(100.0*SUM(n_validas)/NULLIF(SUM(n_lecturas),0),2) AS value FROM operativo.lectura_stream WHERE ts > now() - interval '10 minutes' GROUP BY inversor_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdMarkers": true
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Minutos desde el ultimo dato",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-microrred"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-microrred"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT now() AS time, 'Inversor ' || inversor_id AS metric, EXTRACT(EPOCH FROM (now() - max(ts)))/60 AS value FROM operativo.lectura_stream GROUP BY inversor_id"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Intercambio con la red pública: e_red_kwh (kWh por intervalo)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-microrred"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
