      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-microrred"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (inversor_id) ts AS time, 'Inversor ' || inversor_id AS metric, e_red_kwh AS value FROM operativo.lectura_stream ORDER BY inversor_id, ts DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
