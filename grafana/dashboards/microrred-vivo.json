              },
              {
                "color": "yellow",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 1.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Potencia y energía fotovoltaica vs. demanda de carga (kWh) — Inversor $inversor",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-microrred"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-microrred"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"time\", e_pv_kwh AS \"Solar\", e_carga_kwh AS \"Carga\", e_red_kwh AS \"Red\", e_bat_kwh AS \"Bateria (+descarga)\" FROM operativo.lectura_stream WHERE $__timeFilter(ts) AND inversor_id = $inversor ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Curva de SOC — Inversor $inversor",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-microrred"
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
