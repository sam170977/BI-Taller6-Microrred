            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Estado actual por inversor (simulador)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-microrred"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-microrred"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (inversor_id) inversor_id AS \"Inversor\", ts AS \"Última lectura\", e_pv_kwh AS \"Solar kWh\", e_carga_kwh AS \"Carga kWh\", e_red_kwh AS \"Red kWh\", soc_prom_pct AS \"SOC %\", n_validas AS \"Válidas\", n_lecturas AS \"Lecturas\", escenario AS \"Escenario\" FROM operativo.lectura_stream ORDER BY inversor_id, ts DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Eventos del inversor (rango de tiempo del tablero)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-microrred"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-microrred"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"Hora\", inversor_id AS \"Inversor\", severidad AS \"Severidad\", codigo AS \"Código\", descripcion AS \"Descripción\" FROM operativo.evento_inversor WHERE $__timeFilter(ts) ORDER BY ts DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
