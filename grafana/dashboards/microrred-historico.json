  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Energia por intervalo de 15 min — Inversor $inversor (kWh)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-microrred"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 9
