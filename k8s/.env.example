# Copiar a k8s/.env (NO se sube a git) y completar. Es independiente del .env.example de la raiz.
# Use claves simples (letras y numeros): el ETL las mete en una URL de conexion.
POSTGRES_USER=bi_user
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=microrred_bi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
GF_SECURITY_ADMIN_PASSWORD=cambiar_esta_clave
# Rol de solo lectura que usan Grafana y Power BI (minimo privilegio)
BI_LECTURA_PASSWORD=cambiar_clave_lectura
